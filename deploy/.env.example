# ──────────────────────────────────────────────────────────────────────────────
# DomusMind self-hosted configuration
# Copy this file to .env, then fill in every value marked REQUIRED.
# ──────────────────────────────────────────────────────────────────────────────

# Container registry hosting the images.
IMAGE_REGISTRY=ghcr.io

# Registry namespace - GitHub username or org that published the images.
IMAGE_OWNER=juangcarmona

# REQUIRED - Set this to an exact stable release version (without the leading v),
# for example 1.2.3. Use "edge" only for short-lived testing of the latest main build.
VERSION=REPLACE_WITH_EXACT_STABLE_VERSION

# ── Database ──────────────────────────────────────────────────────────────────

# REQUIRED - PostgreSQL credentials
DB_USER=domusmind
DB_PASSWORD=

# ── Inbox text interpretation ─────────────────────────────────────────────────
# Ollama keeps note text within this deployment. OpenAICompatible sends note text
# to the configured endpoint; the Inbox discloses this to household members.
INBOX_INTERPRETER_PROVIDER=Ollama
# Required only for OpenAICompatible. Use the endpoint's chat/completions URL.
# INBOX_INTERPRETER_ENDPOINT=https://provider.example/v1/chat/completions
# INBOX_INTERPRETER_MODEL=model-name
# INBOX_INTERPRETER_API_KEY=

# ── Authentication ────────────────────────────────────────────────────────────

# REQUIRED - Random secret used to sign JWT tokens.
# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# JWT issuer claim. Change only if you need a custom issuer;
# the API and web must agree on this value.
JWT_ISSUER=domusmind

# Optional audience override. If omitted, Compose uses JWT_ISSUER.
# JWT_AUDIENCE=domusmind

# ── Outlook calendar integration (optional) ──────────────────────────────────
# To enable, register this exact callback URI in the Microsoft Entra app and set
# all values below. Generate the encryption key with:
# openssl rand -base64 32
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT_ID=common
# MICROSOFT_GRAPH_TOKEN_ENCRYPTION_KEY=
# MICROSOFT_GRAPH_REDIRECT_URI=https://your-domusmind.example/settings/oauth/outlook/callback

# ── Ports ─────────────────────────────────────────────────────────────────────

# Host port the DomusMind app listens on.
APP_PORT=24365

# ── Reverse proxy (optional) ──────────────────────────────────────────────────
# The container serves HTTP. For a TLS-terminating proxy, configure it to send
# X-Forwarded-For, X-Forwarded-Proto, and X-Forwarded-Host. List only the proxy
# source IPs or CIDR networks as seen by the DomusMind container. Leave blank
# when accessing DomusMind directly over HTTP.
# Comma-separate multiple IP addresses or CIDR networks.
# REVERSE_PROXY_KNOWN_PROXIES=172.20.0.2
# REVERSE_PROXY_KNOWN_IP_NETWORKS=172.20.0.0/24
# Optional comma-separated allowlist for X-Forwarded-Host values.
# REVERSE_PROXY_ALLOWED_HOSTS=domusmind.example.com

# Swagger UI is disabled by default in Production. Enable only on a trusted network.
SWAGGER_ENABLED=false

# ── First-run bootstrap admin (optional, fallback only) ───────────────────────
# The normal first-run path is the UI-driven setup wizard served at the root URL
# on first visit. Use this block only for headless deployments (scripted
# provisioning, CI, disaster recovery) when the UI is not available.
#
# This path is DISABLED BY DEFAULT and becomes a permanent no-op once the system
# has been initialized (by the wizard or a previous bootstrap run).
#
# To activate: uncomment the BootstrapAdmin__ lines in docker-compose.yml and
# set the values below. Disable again after the system is initialized.
#
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
